# ---------------------------------------------------------------------------
# Connection Lens — copy to `.env` and fill in. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- MinIO (landing zone) --------------------------------------------------
# From inside Docker use the service name (http://minio:9000);
# from the host use http://localhost:9000.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=connection-lens
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_SECURE=false
MINIO_BUCKET=connection-lens
MINIO_RAW_PREFIX=raw/linkedin_connections
# Browser-facing console URL — what links in the app point at.
MINIO_PUBLIC_URL=http://localhost:9001

# Root credentials the MinIO container itself boots with.
MINIO_ROOT_USER=connection-lens
MINIO_ROOT_PASSWORD=change-me-minio-secret

# --- DuckDB (warehouse) ----------------------------------------------------
# Single file. Written ONLY by the Airflow DAG, read read-only by Streamlit (§10).
DUCKDB_PATH=./data/warehouse/warehouse.duckdb

# --- Airflow REST API ------------------------------------------------------
# Trigger modes 2 (MinIO event) and 3 (Streamlit button) call this API (§8).
# Airflow 3: /api/v2 with a JWT fetched from /auth/token.
AIRFLOW_API_BASE_URL=http://localhost:8080
# Browser-facing Airflow URL. Inside Docker the API lives at
# http://airflow-apiserver:8080, which a browser on the host cannot resolve.
AIRFLOW_PUBLIC_URL=http://localhost:8080
AIRFLOW_API_USERNAME=airflow
AIRFLOW_API_PASSWORD=change-me-airflow-password
AIRFLOW_DAG_ID=ingest_connections
AIRFLOW_INGESTION_TASK_ID=ingest_new_objects_to_bronze
AIRFLOW_API_TIMEOUT_SECONDS=15

# Airflow's own admin user (created by `airflow-init`) — keep in sync with the
# API credentials above.
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=change-me-airflow-password
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
# Signs the API tokens. Generate with: openssl rand -base64 32
AIRFLOW_JWT_SECRET=change-me-airflow-jwt-secret
AIRFLOW_POSTGRES_PASSWORD=change-me-postgres-password

# --- MinIO event listener (optional trigger mode 2, §8) --------------------
# Shared secret MinIO must send as `Authorization: Bearer <token>`.
# Leave empty to disable token verification (local-only convenience).
MINIO_EVENT_LISTENER_TOKEN=change-me-listener-token
MINIO_EVENT_LISTENER_PORT=8000

# --- Streamlit app login ---------------------------------------------------
# The single owner account guarding every tab of the app. Unset means the app
# refuses to render at all — it never falls open on real personal data (§1).
STREAMLIT_AUTH_USERNAME=change-me-app-user
STREAMLIT_AUTH_PASSWORD=change-me-app-password

# --- dbt -------------------------------------------------------------------
DBT_PROJECT_DIR=./dbt_project
DBT_PROFILES_DIR=./dbt_project
DBT_TARGET=dev
